generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ChatLog {
  id        String   @id
  sessionId String
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([sessionId])
}

model Document {
  id        String   @id
  userId    String
  title     String?
  content   String
  source    String   @default("uploaded")
  createdAt DateTime @default(now())

  @@index([userId])
}

model Lead {
  id        String   @id
  email     String
  name      String?
  company   String?
  source    String   @default("chat")
  createdAt DateTime @default(now())
}

model analytics {
  id              String    @id
  event_type      String
  conversation_id String?
  user_id         String?
  event_data      Json?
  created_at      DateTime? @default(now()) @db.Timestamp(6)

  @@index([created_at], map: "analytics_created_idx")
  @@index([event_type])
  @@index([user_id], map: "analytics_user_idx")
}

model contacts {
  id              String     @id
  email           String
  name            String?
  phone           String?
  company         String?
  title           String?
  message         String?
  source          String?    @default("chat")
  status          String?    @default("new")
  conversation_id String?
  created_at      DateTime?  @default(now()) @db.Timestamp(6)
  updated_at      DateTime?  @default(now()) @db.Timestamp(6)
  meetings        meetings[]

  @@index([email])
}

model conversations {
  id         String     @id
  session_id String
  user_id    String?
  title      String?
  status     String?    @default("active")
  created_at DateTime?  @default(now()) @db.Timestamp(6)
  updated_at DateTime?  @default(now()) @db.Timestamp(6)
  messages   messages[]

  @@index([session_id], map: "conversations_session_idx")
  @@index([user_id], map: "conversations_user_idx")
}

model database_cache {
  key        String    @id
  value      String
  expires_at DateTime? @db.Timestamp(6)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
}

model ingestion_metadata {
  id             String    @id
  user_id        String
  document_count Int
  timestamp      DateTime? @default(now()) @db.Timestamp(6)
  documents      Json?
  expires_at     DateTime? @db.Timestamp(6)
  created_at     DateTime? @default(now()) @db.Timestamp(6)

  @@index([user_id], map: "ingestion_metadata_user_idx")
}

model meetings {
  id               String    @id
  contact_id       String?
  scheduled_at     DateTime  @db.Timestamp(6)
  duration_minutes Int?      @default(30)
  status           String?   @default("scheduled")
  notes            String?
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)
  contacts         contacts? @relation(fields: [contact_id], references: [id], onUpdate: NoAction)

  @@index([contact_id], map: "meetings_contact_idx")
  @@index([scheduled_at], map: "meetings_scheduled_idx")
}

model messages {
  id              String        @id
  conversation_id String
  role            String
  content         String
  voice_url       String?
  created_at      DateTime?     @default(now()) @db.Timestamp(6)
  metadata        Json?         @default("{}")
  conversations   conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversation_id], map: "messages_conversation_idx")
}

model rate_limits {
  key        String    @id
  count      Int?      @default(1)
  expires_at DateTime  @db.Timestamp(6)
  created_at DateTime? @default(now()) @db.Timestamp(6)

  @@index([expires_at], map: "rate_limits_expires_idx")
}

model sessions {
  id         String    @id
  user_id    String
  token      String    @unique
  expires_at DateTime  @db.Timestamp(6)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id            String     @id
  email         String     @unique
  name          String
  password_hash String
  created_at    DateTime?  @default(now()) @db.Timestamp(6)
  updated_at    DateTime?  @default(now()) @db.Timestamp(6)
  sessions      sessions[]
}

model vectors {
  id         String    @id
  embedding  Json
  content    String
  metadata   Json?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)

  @@index([embedding(ops: JsonbPathOps)], type: Gin)
}
model PhoneCall {
  id            String   @id @default(cuid())
  callId        String   @unique
  callerNumber  String?
  status        String
  startedAt     DateTime?
  endedAt       DateTime?
  duration      Int?
  recordingUrl  String?
  transcript    String?
  summary       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
